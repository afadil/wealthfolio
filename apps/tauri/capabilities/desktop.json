{
  "identifier": "desktop-capability",
  "description": "desktop-capability",
  "local": true,
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:default",
    "deep-link:default",
    "core:app:allow-set-app-theme",
    "core:window:allow-set-theme",
    "core:window:allow-theme",
    "updater:default",
    "log:default",
    "window-state:default",
    "fs:deny-default",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-fstat",
    "fs:allow-start-accessing-security-scoped-resource",
    "fs:allow-stop-accessing-security-scoped-resource",
    {
      "identifier": "fs:scope",
      "deny": [
        "$APPDATA",
        "$APPDATA/**",
        "$APPLOCALDATA",
        "$APPLOCALDATA/**"
      ]
    }
  ]
}
